{
  "manifest_version": 3,
  "name": "My Chrome Extension",
  "version": "1.1.0",
  "description": "请求头捕获 + 书签管理工具",
  "permissions": ["storage", "webRequest", "bookmarks", "alarms", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "commands": {
    "open-bookmark-sidepanel": {
      "suggested_key": { "default": "Ctrl+Shift+B" },
      "description": "打开书签管理侧边栏"
    },
    "focus-search": {
      "suggested_key": { "default": "Ctrl+Shift+F" },
      "description": "聚焦搜索框"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
